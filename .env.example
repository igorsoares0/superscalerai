# Copy to .env and fill in
DATABASE_URL=sqlite:///./dev.db
REPLICATE_API_TOKEN=r8_...
STORAGE_DIR=storage
MAX_UPLOAD_MB=25
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
# Left unset these default to the sandbox prices, so a fresh clone can open a
# checkout with no config. Production MUST set both to the live ids — the app
# refuses to boot on the sandbox pair. Each price's custom_data carries
# {"app": "superscaler", "plan": "<slug>", "credits": <monthly allowance>}.
#PADDLE_PRICE_BASIC=
#PADDLE_PRICE_PRO=
RESEND_API_KEY=
EMAIL_FROM="SuperScaler <no-reply@example.com>"
APP_BASE_URL=http://localhost:8000

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=<access key id>
R2_SECRET_ACCESS_KEY=<secret access key>
R2_BUCKET=superscaler

# Rendered on /terms, /privacy and /refunds. Blank shows a placeholder in the
# page — and in production the app refuses to boot rather than publish it.
LEGAL_ENTITY=
LEGAL_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_GOVERNING_LAW=
# EU/UK buyers have a statutory 14-day withdrawal right regardless.
REFUND_WINDOW_DAYS=14

# --- production only (see deploy/README.md) ---------------------------------
# Turns on the boot checks. Everything above has a dev default that is exactly
# the wrong production value, so put this line in FIRST: the app then refuses
# to start and prints every remaining mistake at once.
#ENVIRONMENT=production
# Read by docker-compose.yml, not by the app: the domain Caddy issues a
# certificate for, and the address Let's Encrypt sends expiry notices to.
#SITE_DOMAIN=superscaler.example
#ACME_EMAIL=you@example.com